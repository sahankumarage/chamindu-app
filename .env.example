# ---- C Printing environment variables ----
# Copy to .env.local for local dev, and set these in Vercel for production.

# Signs login session tokens. Use a long random string in production.
# Generate one with:  openssl rand -base64 32
JWT_SECRET=change-me-to-a-long-random-string

# Turso (libSQL) database — required in production.
# Create a free DB at https://turso.tech then run:
#   turso db show <name> --url        -> TURSO_DATABASE_URL
#   turso db tokens create <name>     -> TURSO_AUTH_TOKEN
# If these are left empty, the app falls back to a local file (./data/app.db)
# which is fine for local development but does NOT work on Vercel.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Vercel Blob — required in production for PDF uploads.
# Auto-added when you create a Blob store in the Vercel dashboard and connect it
# to the project. Locally, leave empty to store uploads in ./data/uploads.
BLOB_READ_WRITE_TOKEN=
